{
  "name": "servo",
  "version": "1.0.0",
  "description": "SERVO is a web application that allows users to book and manage services from various service providers. It provides a platform for service providers to list their services and for users to browse and book those services.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "db:dev:init": "tsx src/config/db.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "dev": "tsx watch src/index.ts",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi",
    "test": "jest",
    "start": "node dist/index.js",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.js",
    "seed": "tsx src/seeds/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "@hono/node-server": "^1.11.2",
    "js-yaml": "^4.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "install": "^0.13.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "3.9.1",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "resend": "^6.17.2",
    "sanitize-html": "^2.17.5",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.22.4",
    "undici": "^8.5.0",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  }
}
