generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
  AGENT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Permission {
  // Users
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE
  USER_SUSPEND

  // Roles
  ROLE_CREATE
  ROLE_READ
  ROLE_UPDATE
  ROLE_DELETE
  ROLE_ASSIGN

  // Stations
  STATION_CREATE
  STATION_READ
  STATION_UPDATE
  STATION_DELETE

  // Orders
  ORDER_CREATE
  ORDER_READ
  ORDER_UPDATE
  ORDER_CANCEL
  ORDER_APPROVE

  // Payments
  PAYMENT_READ
  PAYMENT_VERIFY
  PAYMENT_REFUND

  // Dashboard
  DASHBOARD_READ

  // Settings
  SETTINGS_UPDATE

  // Transactions
  TRANSACTION_READ
}

enum FuelType {
  PETROL
  DIESEL
  COOKING_GAS
}

enum OrderStatus {
  PAYMENT_FAILED
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  PROCESSING
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum IdempotencyStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  SUSPEND
  ASSIGN
  APPROVE
  CANCEL
  VERIFY
  REFUND
}

enum resourceType {
  USER
  ROLE
  STATION
  ORDER
  PAYMENT
  DASHBOARD
  SETTINGS
  TRANSACTION
}

enum workStatus {
  AVAILABLE
  NOT_AVAILABLE
}

model User {
  id                 String             @id @default(uuid())
  stationId          String?
  station            Station?           @relation("StationAgents", fields: [stationId], references: [id], onDelete: SetNull)
  workStatus         workStatus?        @default(AVAILABLE)
  email              String             @unique
  balance            Decimal            @default(0.00) @db.Decimal(10, 2)
  passwordHash       String
  role               UserRole           @default(CUSTOMER)
  accountStatus      AccountStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  token              String?            @unique
  tokenExpiry        DateTime?
  otp                String?            @unique
  otpExpiry          DateTime?
  mustChangePassword Boolean            @default(false)

  userProfile   UserProfile?
  sessionTokens SessionToken[]

  // Customer relationships
  customerOrders Order[] @relation("CustomerOrders")

  // Agent relationships
  assignedOrders Order[] @relation("AssignedOrders")

  // Audit relationships
  completedOrders Order[]    @relation("CompletedOrders")
  cancelledOrders Order[]    @relation("CancelledOrders")
  auditLogs       AuditLog[]

  // Self-referencing suspension relations
  suspensionReason String?
  suspendedAt      DateTime?
  suspendedById    String?
  suspendedBy      User?     @relation("UserSuspensions", fields: [suspendedById], references: [id])
  suspendedUsers   User[]    @relation("UserSuspensions")

  createdAt         DateTime  @default(now())
  passwordChangedAt DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([role])
  @@index([accountStatus])
  @@index([stationId, role, workStatus])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String   @unique
  dateOfBirth DateTime
  address     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Added Cascade delete
}

model Station {
  id             String    @id @default(uuid())
  name           String
  addressState   String
  addressStreet  String
  addressCity    String
  addressCountry String    @default("Nigeria")
  isAvailable    Boolean   @default(false)
  latitude       Decimal   @db.Decimal(10, 8)
  longitude      Decimal   @db.Decimal(11, 8)
  openTime       DateTime? @db.Time()
  closeTime      DateTime? @db.Time()
  is24h          Boolean   @default(false)

  fuelTypes FuelType[]
  prices    Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orders Order[]
  agents User[]  @relation("StationAgents")

  @@unique([name, addressStreet, addressCity])
  @@index([addressCity])
  @@index([isAvailable])
}

model SessionToken {
  id             String    @id @default(uuid())
  sessionTokenId String    @unique
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  usedAt         DateTime?
  revoked        Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id String @id @default(uuid())

  // Customer
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  // Agent handling this order
  assignedAgentId String?
  assignedAgent   User?   @relation("AssignedOrders", fields: [assignedAgentId], references: [id])

  stationId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  status OrderStatus @default(PENDING_PAYMENT)

  fuelType FuelType

  quantity     Decimal @db.Decimal(10, 2)
  unitPrice    Decimal @db.Decimal(10, 2)
  fuelSubtotal Decimal @db.Decimal(10, 2)
  totalAmount  Decimal @db.Decimal(10, 2)
  deliveryFee  Decimal @db.Decimal(10, 2)
  VAT          Decimal @db.Decimal(10, 2)

  deliveryAddress String

  transactions Transaction[]

  // Audit (optional)
  completedById String?
  completedBy   User?   @relation("CompletedOrders", fields: [completedById], references: [id])

  cancelledById String?
  cancelledBy   User?   @relation("CancelledOrders", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("NGN")
  paymentMethod    PaymentMethod
  status           PaymentStatus @default(PENDING)
  reference        String        @unique
  failureReason    String?
  gatewayReference String?
  authorizationUrl String?
  accessCode       String?
  paidAt           DateTime?
  gatewayResponse  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model IdempotencyRequest {
  id          String            @id @default(cuid())
  key         String
  route       String
  userId      String?
  status      IdempotencyStatus @default(PENDING)
  requestHash String?
  response    Json?
  error       Json?
  lockedAt    DateTime?
  completedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([key, route])
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String        @id @default(uuid())
  userId       String?
  action       AuditAction
  resourceType resourceType?
  resourceId   String?       @db.VarChar(100)
  status       String        @db.VarChar(20)
  errorMessage String?
  ipAddress    String?       @db.Inet
  userAgent    String?
  metadata     Json?
  createdAt    DateTime      @default(now()) @db.Timestamp(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PriceSettings {
  id            String             @id @default(uuid())

  deliveryFeeId String             @unique
  deliveryFee   PriceSettingsValue @relation("DeliveryFeeRelation", fields: [deliveryFeeId], references: [id])

  vatId         String             @unique
  vat           PriceSettingsValue @relation("VatRelation", fields: [vatId], references: [id])
}

model PriceSettingsValue {
  id                  String         @id @default(uuid())
  isEnable            Boolean        @default(true)
  value               Decimal
  deliveryFeeSettings PriceSettings? @relation("DeliveryFeeRelation")
  vatSettings         PriceSettings? @relation("VatRelation")
}