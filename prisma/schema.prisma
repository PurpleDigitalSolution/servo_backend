generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DRIVER
  ADMIN
  AGENT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Permission {
  // Users
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE
  USER_SUSPEND

  // Roles
  ROLE_CREATE
  ROLE_READ
  ROLE_UPDATE
  ROLE_DELETE
  ROLE_ASSIGN

  // Stations
  STATION_CREATE
  STATION_READ
  STATION_UPDATE
  STATION_DELETE

  // Orders
  ORDER_READ
  ORDER_UPDATE
  ORDER_CANCEL
  ORDER_APPROVE

  // Payments
  PAYMENT_READ
  PAYMENT_VERIFY
  PAYMENT_REFUND

  // Dashboard
  DASHBOARD_READ

  // Settings
  SETTINGS_UPDATE
}

enum FuelType {
  PETROL
  DIESEL
  COOKING_GAS
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  balance            Decimal            @default(0.00) @db.Decimal(10, 2) // Fixed: Use Decimal for money
  passwordHash       String
  role               UserRole           @default(USER)
  accountStatus      AccountStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  token              String?            @unique
  tokenExpiry        DateTime?
  otp                String?            @unique
  otpExpiry          DateTime?

  userProfile   UserProfile?
  sessionTokens SessionToken[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([accountStatus])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String   @unique
  dateOfBirth DateTime
  address     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Added Cascade delete
}

model Station {
  id             String    @id @default(uuid())
  name           String
  addressState   String
  addressStreet  String
  addressCity    String
  addressCountry String    @default("Nigeria")
  isAvailable    Boolean   @default(false)
  latitude       Decimal   @db.Decimal(10, 8)
  longitude      Decimal   @db.Decimal(11, 8)
  openTime       DateTime? @db.Time()
  closeTime      DateTime? @db.Time()
  is24h          Boolean   @default(false)

  fuelTypes FuelType[]
  prices    Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orders Order[]

  @@unique([name, addressStreet, addressCity])
  @@index([addressCity])
  @@index([isAvailable])
}

model SessionToken {
  id             String    @id @default(uuid())
  sessionTokenId String    @unique
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  usedAt         DateTime?
  revoked        Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  stationId       String
  status          OrderStatus @default(PENDING_PAYMENT)
  fuelType        FuelType
  quantity        Decimal     @db.Decimal(10, 2)
  price           Decimal     @db.Decimal(10, 2)
  deliveryAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  station      Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount             Decimal         @db.Decimal(10,2)
  currency           String          @default("NGN")
  paymentMethod      PaymentMethod
  status             PaymentStatus   @default(PENDING)
  reference          String          @unique
  gatewayReference   String?
  authorizationUrl   String?
  accessCode         String?
  paidAt             DateTime?
  gatewayResponse    Json?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}
