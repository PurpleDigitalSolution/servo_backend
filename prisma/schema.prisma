generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DRIVER
  ADMIN
  AGENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}
enum DeliveryDriverStatus {
  ACTIVE
  INACTIVE
  ON_BREAK
  SUSPENDED
}

enum AvailabilityStatus {
  ONLINE
  OFFLINE
  ON_DELIVERY
}
enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  WALLET
  TRANSFER
}

model User{
  id                String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(USER)
  accountStatus      AccountStatus       @default(ACTIVE)
  verificationStatus VerificationStatus  @default(PENDING)

  Account            Account?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Account{
  id                String              @id @default(uuid())
  userId            String              @unique
  balance           Float               @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id])
}